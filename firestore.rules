rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedEmail() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedEmail() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'akakukoabel@gmail.com'
      );
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap & Strict Shape Enforcement)
    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'defaultPersona',
          'defaultDepth', 'soundEnabled', 'privacyAcceptedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role == 'customer'
        && (!('defaultPersona' in data) || (data.defaultPersona is string && data.defaultPersona.size() <= 64))
        && (!('defaultDepth' in data) || (data.defaultDepth is string && data.defaultDepth.size() <= 64))
        && (!('soundEnabled' in data) || data.soundEnabled is bool)
        && (!('privacyAcceptedAt' in data) || (data.privacyAcceptedAt is string && data.privacyAcceptedAt.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMissionRecord(data, userId, missionId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'goal', 'persona', 'executionDepth',
          'targetDeadline', 'status', 'progress', 'startedAt', 'executionSpeed',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'goal', 'persona', 'executionDepth',
          'targetDeadline', 'status', 'currentStage', 'progress', 'currentStepId',
          'lastCheckpointStepId', 'understanding', 'clarificationAnswers',
          'clarificationResolved', 'tasks', 'logs', 'artifactsSummary',
          'report', 'responseFeedback', 'startedAt', 'endedAt', 'elapsedMs',
          'executionSpeed', 'migratedFromGuest', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == missionId
        && isValidId(data.ownerId) && data.ownerId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.goal is string && data.goal.size() >= 1 && data.goal.size() <= 4000
        && data.persona is string && data.persona.size() >= 1 && data.persona.size() <= 64
        && data.executionDepth is string && data.executionDepth.size() >= 1 && data.executionDepth.size() <= 64
        && data.targetDeadline is string && data.targetDeadline.size() >= 1 && data.targetDeadline.size() <= 64
        && data.status in [
          'idle', 'planning', 'awaiting_clarification', 'executing',
          'awaiting_approval', 'paused', 'completed', 'cancelled', 'failed'
        ]
        && data.progress is number && data.progress >= 0 && data.progress <= 100
        && data.startedAt is string && data.startedAt.size() >= 1 && data.startedAt.size() <= 40
        && data.executionSpeed is number && data.executionSpeed >= 1 && data.executionSpeed <= 4
        && (!('currentStage' in data) || (data.currentStage is string && data.currentStage.size() <= 32))
        && (!('currentStepId' in data) || (data.currentStepId is string && data.currentStepId.size() <= 128))
        && (!('lastCheckpointStepId' in data) || (data.lastCheckpointStepId is string && data.lastCheckpointStepId.size() <= 128))
        && (!('understanding' in data) || (data.understanding is map && data.understanding.keys().size() <= 20))
        && (!('clarificationAnswers' in data) || (data.clarificationAnswers is map && data.clarificationAnswers.keys().size() <= 20))
        && (!('clarificationResolved' in data) || data.clarificationResolved is bool)
        && (!('tasks' in data) || (data.tasks is list && data.tasks.size() <= 20 && (data.tasks.size() == 0 || data.tasks[0] is map)))
        && (!('logs' in data) || (data.logs is list && data.logs.size() <= 250 && (data.logs.size() == 0 || data.logs[0] is map)))
        && (!('artifactsSummary' in data) || (data.artifactsSummary is list && data.artifactsSummary.size() <= 30 && (data.artifactsSummary.size() == 0 || data.artifactsSummary[0] is map)))
        && (!('report' in data) || (data.report is map && data.report.keys().size() <= 40))
        && (!('responseFeedback' in data) || (data.responseFeedback is map && data.responseFeedback.keys().size() <= 40))
        && (!('endedAt' in data) || (data.endedAt is string && data.endedAt.size() <= 40))
        && (!('elapsedMs' in data) || (data.elapsedMs is number && data.elapsedMs >= 0))
        && (!('migratedFromGuest' in data) || data.migratedFromGuest is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMissionFile(data, userId, missionId, fileId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'missionId', 'name', 'format', 'content',
          'timestamp', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'missionId', 'name', 'format', 'content',
          'stepId', 'timestamp', 'isRealExecution', 'validated',
          'validationSummary', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == fileId
        && isValidId(data.ownerId) && data.ownerId == userId
        && isValidId(data.missionId) && data.missionId == missionId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 180
        && data.format is string && data.format.size() >= 1 && data.format.size() <= 32
        && data.content is string && data.content.size() <= 500000
        && data.timestamp is string && data.timestamp.size() >= 1 && data.timestamp.size() <= 40
        && (!('stepId' in data) || (data.stepId is string && data.stepId.size() <= 128))
        && (!('isRealExecution' in data) || data.isRealExecution is bool)
        && (!('validated' in data) || data.validated is bool)
        && (!('validationSummary' in data) || (data.validationSummary is string && data.validationSummary.size() <= 2000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isAdmin() || (isVerifiedEmail() && request.auth.uid == adminUid));
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'defaultPersona', 'defaultDepth',
          'soundEnabled', 'privacyAcceptedAt', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isVerifiedOwner(userId);

      match /missions/{missionId} {
        allow get: if isValidId(userId) && isValidId(missionId) && isVerifiedOwner(userId);
        allow list: if isValidId(userId) && isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(missionId)
          && isVerifiedOwner(userId)
          && isValidMissionRecord(incoming(), userId, missionId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            exists(/databases/$(database)/documents/users/$(userId)) ||
            existsAfter(/databases/$(database)/documents/users/$(userId))
          );
        allow update: if isValidId(userId)
          && isValidId(missionId)
          && isVerifiedOwner(userId)
          && isValidMissionRecord(incoming(), userId, missionId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().goal == existing().goal
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Action 1: Active/Resumable Mission State Update
            (
              !(existing().status in ['completed', 'cancelled']) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'status', 'currentStage', 'progress', 'currentStepId',
                'lastCheckpointStepId', 'understanding', 'clarificationAnswers',
                'clarificationResolved', 'tasks', 'logs', 'artifactsSummary',
                'report', 'responseFeedback', 'endedAt', 'elapsedMs',
                'executionSpeed', 'updatedAt'
              ])
            ) ||
            // Action 2: Post-Completion Feedback Rating Update Only (Terminal State Locked)
            (
              existing().status in ['completed', 'cancelled'] &&
              incoming().status == existing().status &&
              incoming().diff(existing()).affectedKeys().hasOnly(['responseFeedback', 'updatedAt'])
            )
          );
        allow delete: if isValidId(userId) && isValidId(missionId) && isVerifiedOwner(userId);

        match /files/{fileId} {
          allow get: if isValidId(userId) && isValidId(missionId) && isValidId(fileId) && isVerifiedOwner(userId);
          allow list: if isValidId(userId) && isValidId(missionId) && isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
          allow create: if isValidId(userId)
            && isValidId(missionId)
            && isValidId(fileId)
            && isVerifiedOwner(userId)
            && isValidMissionFile(incoming(), userId, missionId, fileId)
            && incoming().ownerId == request.auth.uid
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && (
              exists(/databases/$(database)/documents/users/$(userId)/missions/$(missionId)) ||
              existsAfter(/databases/$(database)/documents/users/$(userId)/missions/$(missionId))
            );
          allow update: if isValidId(userId)
            && isValidId(missionId)
            && isValidId(fileId)
            && isVerifiedOwner(userId)
            && isValidMissionFile(incoming(), userId, missionId, fileId)
            && incoming().id == existing().id
            && incoming().ownerId == existing().ownerId
            && incoming().missionId == existing().missionId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && exists(/databases/$(database)/documents/users/$(userId)/missions/$(missionId))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'content', 'validated', 'validationSummary', 'isRealExecution', 'timestamp', 'updatedAt'
            ]);
          allow delete: if isValidId(userId) && isValidId(missionId) && isValidId(fileId) && isVerifiedOwner(userId);
        }
      }
    }
  }
}
